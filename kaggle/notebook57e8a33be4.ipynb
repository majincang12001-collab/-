   "source": "import torch, time\nfrom diffusers import StableDiffusionPipeline\n# 固定随机种子，建立角色参考图的可复现基准\nseed=20261123\ngenerator=torch.Generator(device='cuda').manual_seed(seed)\nprompt='anime character portrait, young adult female fantasy heroine, long black hair, clear amber eyes, calm confident expression, elegant dark blue and silver fantasy outfit, detailed anime illustration, clean face, consistent character design, soft cinematic lighting'\nnegative='blurry, low quality, distorted face, extra fingers, text, watermark, duplicate'\nt0=time.time()\nref_img=pipe(prompt, negative_prompt=negative, num_inference_steps=24, guidance_scale=7.0, height=512, width=512, generator=generator).images[0]\nout='/kaggle/working/heroine_reference_seed20261123.png'\nref_img.save(out)\nprint('CHARACTER_REFERENCE_SAVED',out,ref_img.size,'seed',seed,'seconds',round(time.time()-t0,1))",
