   "source": "from PIL import Image, ImageOps, ImageDraw\nimport torch, time, os, traceback\nref_path='/kaggle/working/heroine_reference_seed20261123.png'\nref=Image.open(ref_path).convert('RGB')\nprint('REFERENCE',ref.size,os.path.getsize(ref_path))\nprompts=[\n     'same young adult anime fantasy heroine as the reference image, long glossy black hair, violet eyes, delicate face, wearing the same dark navy and silver fantasy outfit, front view, neutral standing pose, clean light background, full character design sheet',\n     'same young adult anime fantasy heroine as the reference image, long glossy black hair, violet eyes, delicate face, wearing the same dark navy and silver fantasy outfit, strict side profile facing right, neutral standing pose, clean light background, character design sheet',\n     'same young adult anime fantasy heroine as the reference image, long glossy black hair, violet eyes, delicate face, wearing the same dark navy and silver fantasy outfit, full body view, standing pose, clean light background, character design sheet'\n]\nfiles=[]\nfor i,prompt in enumerate(prompts):\n        t0=time.time()\n        g=torch.Generator(device='cuda').manual_seed(20261124+i)\n        result=pipe(prompt, ip_adapter_image=ref, num_inference_steps=18, guidance_scale=6.5, height=512, width=512, generator=g)\n        out=f'/kaggle/working/ipadapter_view_{i+1}.png'\n        result.images[0].save(out)\n        files.append(out)\n        print('VIEW_SAVED',i+1,out,round(time.time()-t0,1),'sec')\n    thumbs=[Image.open(p).convert('RGB').resize((384,384)) for p in files]\nsheet=Image.new('RGB',(384*3,420),(245,245,245))\nfor i,im in enumerate(thumbs):\n        sheet.paste(im,(384*i,0))\n        ImageDraw.Draw(sheet).text((384*i+12,390),['FRONT','SIDE','FULL BODY'][i],fill=(20,20,20))\n    sheet.save('/kaggle/working/ipadapter_consistency_contact_sheet.png')\nprint('CONTACT_SHEET_SAVED','/kaggle/working/ipadapter_consistency_contact_sheet.png')\n]",
